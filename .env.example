# ─── Supabase ────────────────────────────────────────────────────
# Project URL — found in Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co

# anon/public key for client-side operations (RLS enforced)
# OR service_role key for server-side (bypasses RLS — keep secret!)
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# JWT secret — Dashboard > Settings > API > JWT Settings
# Used to verify auth tokens server-side
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ─── LLM APIs ────────────────────────────────────────────────────
# Groq (used for Aria, Oracle, EBF analysis, snapshot, identity, session facts)
GROQ_API_KEY=gsk_...

# Mistral (legacy — keep if you switch back)
MISTRAL_API_KEY=

# ─── App ─────────────────────────────────────────────────────────
# Set to "production" to disable debug output
APP_ENV=development
