# ─── Supabase ────────────────────────────────────────────────────
# Project URL — found in Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co

# service_role key for server-side operations (bypasses RLS — keep secret!)
SUPABASE_KEY=your-supabase-service-role-key

# JWT secret — Dashboard > Settings > API > JWT Settings
# Used to verify auth tokens server-side
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ─── LLM ─────────────────────────────────────────────────────────
# OpenRouter — aggregates 200+ free and paid models via one API key.
# Get a free key at https://openrouter.ai
# The fallback chains in pipeline/llm_client.py cycle through many models
# automatically if any model is down or rate-limited.
OPENROUTER_API_KEY=sk-or-v1-...

# ─── App ─────────────────────────────────────────────────────────
# Set to "production" to disable debug output
APP_ENV=development
